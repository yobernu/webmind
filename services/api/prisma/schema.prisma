generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is an ESM package compiled with moduleResolution "nodenext", so the
  // generated client must emit ESM with explicit `.js` import specifiers.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7 takes the connection URL from `prisma.config.ts` for Migrate, and
// from the driver adapter passed to the PrismaClient constructor at runtime.
datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
}

model User {
  id String @id @default(uuid())

  email String @unique

  /// Null for accounts that only ever signed in through a provider.
  passwordHash String?

  name          String?
  avatarUrl     String?
  emailVerified Boolean @default(false)

  identities AuthIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// One row per external account linked to a user, so further providers can be
/// added without another migration.
model AuthIdentity {
  id String @id @default(uuid())

  userId            String
  provider          AuthProvider
  providerAccountId String

  /// Email as reported by the provider, which may drift from `user.email`.
  email String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}
