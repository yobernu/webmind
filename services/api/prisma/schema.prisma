generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is an ESM package compiled with moduleResolution "nodenext", so the
  // generated client must emit ESM with explicit `.js` import specifiers.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7 takes the connection URL from `prisma.config.ts` for Migrate, and
// from the driver adapter passed to the PrismaClient constructor at runtime.
datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id String @id @default(uuid())

  email String @unique

  /// Null for accounts that only ever signed in through a provider.
  passwordHash String?

  name          String?
  avatarUrl     String?
  emailVerified Boolean @default(false)

  /// Chosen answer provider ("gemini" | "openrouter") and model. Null means
  /// the server default. Stored per user rather than per device so the choice
  /// follows the account.
  aiProvider String?
  aiModel    String?

  /// Whether this user may use their own provider keys. The entitlement half
  /// of the BYOK chain; a stored credential is ignored while this is false.
  byokEnabled Boolean @default(true)

  identities    AuthIdentity[]
  pages         Page[]
  conversations Conversation[]
  notes         Note[]
  highlights    Highlight[]
  embeddings    Embedding[]
  credentials   ProviderCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// One row per external account linked to a user, so further providers can be
/// added without another migration.
model AuthIdentity {
  id String @id @default(uuid())

  userId            String
  provider          AuthProvider
  providerAccountId String

  /// Email as reported by the provider, which may drift from `user.email`.
  email String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

/// A web page as seen by one user. Pages are per-user because everything hung
/// off them (notes, highlights, conversations) is private to that user.
model Page {
  id     String @id @default(uuid())
  userId String

  /// The URL exactly as visited, kept for display and debugging.
  url String

  /// Normalised identity of the page: tracking parameters and fragments
  /// removed, `rel="canonical"` honoured. Two visits that normalise the same
  /// are the same page.
  canonicalUrl String

  domain String
  title  String?

  /// sha256 of the extracted text, so unchanged content is never re-uploaded.
  contentHash String?
  content     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes         Note[]
  highlights    Highlight[]

  // No separate index on userId: this unique index already leads with it.
  @@unique([userId, canonicalUrl])
  @@index([domain])
  @@map("pages")
}

model Conversation {
  id     String @id @default(uuid())
  userId String
  pageId String

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([pageId])
  @@map("conversations")
}

model Message {
  id             String @id @default(uuid())
  conversationId String

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Note {
  id     String @id @default(uuid())
  userId String
  pageId String

  content String

  /// The passage the note was written against, when it came from a selection.
  sourceText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@map("notes")
}

/// A chunk of source text plus its embedding, used to select only the relevant
/// part of a large page for the AI prompt. `sourceType` keeps the table open to
/// notes and highlights later without restructuring.
///
/// `embedding` is `Unsupported`, so every read and write of it goes through raw
/// SQL in EmbeddingsRepository. The dimensionality is fixed by the column type:
/// changing GEMINI_EMBEDDING_DIMENSIONS requires a migration and a re-embed.
model Embedding {
  id     String @id @default(uuid())
  userId String

  sourceType String
  sourceId   String
  chunkIndex Int

  /// The chunk itself, so a similarity hit can be placed into the prompt.
  content String

  embedding Unsupported("vector(768)")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([userId])
  @@map("embeddings")
}

model Highlight {
  id     String @id @default(uuid())
  userId String
  pageId String

  selectedText String

  /// Anchoring information used to re-find the passage in the live DOM.
  selector Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@map("highlights")
}

/// A provider API key belonging to one user.
///
/// The key is stored only as AES-256-GCM ciphertext, and the sealed form is
/// bound to (userId, provider, keyVersion) as additional authenticated data:
/// a row copied into another user cannot be decrypted, so database write access
/// does not become a way to spend someone else's quota.
model ProviderCredential {
  id     String @id @default(uuid())
  userId String

  /// Matches AI_PROVIDER_IDS: "gemini" | "openrouter".
  provider String

  ciphertext String
  iv         String
  authTag    String

  /// Lets a future master-key rotation re-wrap rows without a schema change.
  keyVersion Int @default(1)

  /// Masked tail of the key, so the UI can show which one is stored.
  hint String

  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("provider_credentials")
}
