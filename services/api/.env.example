# Copy to `.env` and fill in. `.env` is gitignored.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://webmind:webmind@localhost:5433/webmind?schema=public"

# Secret used to sign JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# HTTP port for the Nest API.
PORT=3000

# Google OAuth client id of a "Web application" client whose authorised
# redirect URIs include https://<extension-id>.chromiumapp.org/. Public value;
# the flow uses response_type=id_token, so the client secret is never needed.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Gemini (server-side only, per SRS §3). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional overrides; defaults are gemini-3.8-flash and gemini-embedding-001.
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# --- OpenRouter (optional second answer provider) ---
# Answers only: OpenRouter has no embeddings endpoint, so retrieval over long
# pages still requires GEMINI_API_KEY.
OPENROUTER_API_KEY=""
# Comma-separated models offered in the extension's picker; first is default.
OPENROUTER_MODELS="openai/gpt-5.2,nvidia/nemotron-3.5-lightning:free"
# Optional attribution shown on openrouter.ai rankings.
OPENROUTER_SITE_URL=""
OPENROUTER_SITE_NAME="WebMind"

# Comma-separated Gemini models offered in the picker; first is default.
GEMINI_MODELS="gemini-3.8-flash,gemini-3.5-flash-lite"

# --- BYOK (users' own provider keys) ---
# 32 random bytes, base64. Encrypts stored user API keys (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Absent: users cannot store keys and the server uses its own. Malformed: the
# server refuses to start, because a half-configured secret store is worse.
# Rotating this makes every stored user key unreadable.
CREDENTIAL_ENCRYPTION_KEY="generate-me-32-random-bytes-base64"
