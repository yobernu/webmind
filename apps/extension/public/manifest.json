{
  "manifest_version": 3,
  "name": "WebMind",
  "version": "0.1.0",
  "description": "Your persistent AI workspace for the web.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open WebMind"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
