{
  "name": "extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts && vite build --config vite.extract.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:firefox": "pnpm build && node scripts/firefox.mjs manifest",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "start:firefox": "web-ext run --source-dir dist-firefox --start-url https://developer.mozilla.org/en-US/docs/Web/API/Window/fetch",
    "package:firefox": "node scripts/firefox.mjs check-api && pnpm build:firefox && web-ext lint --source-dir dist-firefox && web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --filename gloss_ai-{version}.zip --overwrite-dest && node scripts/firefox.mjs source"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
